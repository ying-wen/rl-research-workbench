{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RL Research Workbench protocol v1",
  "description": "Structural editor schema. CLI validation additionally checks seed isolation, budget arithmetic, native capabilities, confirmation hashes and declared module contracts.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "study_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
    },
    "track": {
      "enum": [
        "classic",
        "deep",
        "continual"
      ]
    },
    "purpose": {
      "enum": [
        "smoke",
        "development",
        "confirmation"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "primary_metric": {
      "type": "string",
      "minLength": 1
    },
    "direction": {
      "enum": [
        "maximize",
        "minimize"
      ]
    },
    "minimum_effect": {
      "type": "number",
      "minimum": 0
    },
    "seeds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 2
    },
    "holdout_seeds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "steps": {
          "type": "integer",
          "minimum": 1
        },
        "eval_episodes": {
          "type": "integer",
          "minimum": 0
        },
        "max_eval_steps": {
          "type": "integer",
          "minimum": 0
        },
        "max_total_steps": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "steps",
        "eval_episodes",
        "max_eval_steps",
        "max_total_steps"
      ]
    },
    "selection": {
      "type": "object",
      "properties": {
        "mode": {
          "const": "preselected"
        },
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "uses": {
          "const": "development_only"
        },
        "frozen_from": {
          "type": "object"
        }
      },
      "required": [
        "mode",
        "rule",
        "uses"
      ]
    },
    "failure_policy": {
      "type": "object",
      "properties": {
        "mode": {
          "const": "score_floor"
        },
        "score_floor": {
          "type": "number"
        }
      },
      "required": [
        "mode",
        "score_floor"
      ]
    },
    "baseline_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
      }
    },
    "arms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
          },
          "algorithm": {
            "type": "string",
            "minLength": 1
          },
          "config": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "algorithm",
          "config"
        ]
      }
    },
    "envs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
          },
          "environment": {
            "type": "string",
            "minLength": 1
          },
          "config": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "environment",
          "config"
        ]
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^https?://"
          }
        }
      },
      "required": [
        "sources"
      ]
    },
    "checks": {
      "type": "object",
      "properties": {
        "implementation": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mechanism": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "performance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "implementation",
        "mechanism",
        "performance"
      ]
    },
    "input_adapter_ready": {
      "type": "boolean"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "lineage": {
      "type": "object"
    },
    "design_status": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "study_id",
    "track",
    "purpose",
    "question",
    "hypothesis",
    "primary_metric",
    "direction",
    "minimum_effect",
    "seeds",
    "holdout_seeds",
    "budget",
    "selection",
    "failure_policy",
    "baseline_ids",
    "arms",
    "envs",
    "provenance",
    "checks"
  ]
}
